# ============================================================
#  桌游设计工作坊 — Git 忽略规则
# ============================================================

# ---------- 密钥与本地配置（最重要，切勿提交）----------
.env
.env.*
!.env.example
secrets.json
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
build/
sdist/

# ---------- Node / 前端 ----------
node_modules/
web/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 用户数据（首次启动由 server/util/seed.py 自动重建）----------
# 包含项目 JSON、AI 生成的底板/配图、任务记录、Spike 产物，属于本地数据
workspace/

# ---------- 参考素材（第三方网页快照 + 逆向参考实现）----------
# 若希望连同参考材料一起发布，删除下面这一行即可
examples/

# ---------- AI 助手本地工作记忆 ----------
# 如需随仓库同步，删除下面这一行
.codebuddy/

# ---------- 编辑器 / 操作系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时产物 ----------
*.log
*.tmp
*.bak
*.orig
*.rej
